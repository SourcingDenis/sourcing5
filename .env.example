# ============================================================================
# Supabase Configuration
# ============================================================================
# Find these in your Supabase project: Settings > API
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ============================================================================
# Application Configuration
# ============================================================================
NEXT_PUBLIC_APP_NAME=Sourcer OS

# Local development - use localhost
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Production - use your Netlify URL
# NEXT_PUBLIC_APP_URL=https://your-site.netlify.app
# Or your custom domain:
# NEXT_PUBLIC_APP_URL=https://your-custom-domain.com

# ============================================================================
# Deployment-specific Notes
# ============================================================================
# For Netlify deployment:
# 1. Set environment variables in Netlify Dashboard (Settings > Build & deploy > Environment)
# 2. DO NOT commit .env.local - it's git-ignored
# 3. Update NEXT_PUBLIC_APP_URL to match your deployed domain
# 4. Ensure Netlify domain is added to Supabase CORS settings

# For Local Development:
# 1. Copy this file: cp .env.example .env.local
# 2. Fill in your Supabase credentials
# 3. Use NEXT_PUBLIC_APP_URL=http://localhost:3000

# NOTE: The Ashby API key is configured via the UI at /settings
# and stored in the app_settings database table — not in environment variables.
